# Copy to .env.local for local overrides. All values have safe production defaults
# in lib/config.ts, so the build works without any .env file.

# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://invoicor.com

# Django API base URL. No trailing slash.
NEXT_PUBLIC_API_URL=https://invoicor.com/api

# Optional: App Store Connect provider token, enables per-page install attribution (ct=).
# Find it in App Store Connect > App Analytics > Campaigns.
NEXT_PUBLIC_APP_STORE_PROVIDER_TOKEN=

# Set to "false" to build without analytics scripts (e.g. a staging build).
NEXT_PUBLIC_ANALYTICS=true
