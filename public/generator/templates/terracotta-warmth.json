{
  "html": "<!-- tier: free -->\n<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Invoice {{INVOICE_NUMBER}}</title>\n    <style>\n        :root {\n            --font-family: 'Palatino Linotype', 'Book Antiqua', Palatino, serif;\n            --font-size-base: 12px;\n            --font-size-sm: 10px;\n            --font-size-md: 13px;\n            --font-size-lg: 18px;\n            --font-size-xl: 24px;\n            --font-size-total: 16px;\n            --line-height: 1.4;\n            --radius: 4px;\n\n            --color-text: #3d2c22;\n            --color-text-bold: #2a1a10;\n            --color-text-muted: #6b5548;\n            --color-text-label: #8c7567;\n            --color-text-faint: #b09a8c;\n            --color-accent: #c25b28;\n            --color-bg: #faf6f1;\n            --color-bg-subtle: #f0e8df;\n            --color-border: #e8ddd1;\n            --color-border-strong: #d4c4b3;\n\n            --page-margin-top: 18mm;\n            --page-margin-bottom: 18mm;\n            --page-margin-x: 15mm;\n        }\n\n        @page {\n            size: A4;\n            margin: 0;\n        }\n\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: var(--font-family);\n            background-color: var(--color-bg);\n            padding: 0;\n            margin: 0;\n        }\n\n        .a4 {\n            width: 210mm;\n            height: 297mm;\n            background: var(--color-bg);\n            overflow: hidden;\n            position: relative;\n        }\n\n        /* Left accent bar */\n        .a4::before {\n            content: '';\n            position: absolute;\n            left: 0;\n            top: 0;\n            bottom: 0;\n            width: 6px;\n            background: var(--color-accent);\n        }\n\n        .a4_inner {\n            width: 100%;\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n            font-size: var(--font-size-base);\n            line-height: var(--line-height);\n            color: var(--color-text);\n            -webkit-print-color-adjust: exact;\n            print-color-adjust: exact;\n        }\n\n        .h:empty {\n            display: none !important;\n        }\n\n        .hide-line:has(> .h:empty) {\n            display: none !important;\n        }\n\n        .hide-line:has(> .info_text > .h:empty) {\n            display: none !important;\n        }\n\n        .hide-if-empty:not(:has(.h:not(:empty))) {\n            display: none !important;\n        }\n\n        .optional_line:has(.h:empty) {\n            display: none !important;\n        }\n\n        .clamp-1 {\n            display: -webkit-box;\n            -webkit-line-clamp: 1;\n            -webkit-box-orient: vertical;\n            overflow: hidden;\n            text-overflow: ellipsis;\n        }\n\n        .clamp-2 {\n            display: -webkit-box;\n            -webkit-line-clamp: 2;\n            -webkit-box-orient: vertical;\n            overflow: hidden;\n            text-overflow: ellipsis;\n        }\n\n        .clamp-3 {\n            display: -webkit-box;\n            -webkit-line-clamp: 3;\n            -webkit-box-orient: vertical;\n            overflow: hidden;\n            text-overflow: ellipsis;\n        }\n\n        .zone_header {\n            flex: 0 0 auto;\n            width: 100%;\n            padding: var(--page-margin-top) var(--page-margin-x) 0;\n        }\n\n        .zone_info {\n            flex: 0 0 auto;\n            width: 100%;\n            max-height: 200px;\n            overflow: hidden;\n            padding: 0 var(--page-margin-x);\n        }\n\n        .zone_items {\n            flex: 0 0 auto;\n            width: 100%;\n            margin-top: 24px;\n            margin-bottom: 16px;\n            min-height: 80mm;\n            padding: 0 var(--page-margin-x);\n        }\n\n        .zone_totals {\n            flex: 0 0 auto;\n            width: 100%;\n            max-height: 180px;\n            overflow: hidden;\n            padding: 0 var(--page-margin-x);\n        }\n\n        .zone_footer {\n            flex: 0 0 auto;\n            margin-top: auto;\n            width: 100%;\n            padding: 16px var(--page-margin-x) var(--page-margin-bottom);\n        }\n\n        .header_row {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            width: 100%;\n            padding-bottom: 10px;\n            border-bottom: 2px solid var(--color-border-strong);\n        }\n\n        .header_brand {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            max-width: 60%;\n            flex-wrap: wrap;\n        }\n\n        .header_logo {\n            display: block;\n            height: 120px;\n            width: auto;\n            max-width: 280px;\n            min-width: 36px;\n            object-fit: contain;\n        }\n\n        .header_logo[src*=\"R0lGODlhAQABA\"],\n        .header_logo[src=\"\"] {\n            display: none !important;\n        }\n\n        .header_logo:not([src=\"\"]):not([src*=\"R0lGODlhAQABA\"])+.header_company {\n            display: none !important;\n        }\n\n        .header_company {\n            font-size: var(--font-size-lg);\n            font-weight: 700;\n            color: var(--color-text-bold);\n        }\n\n        .header_inv {\n            text-align: right;\n            flex-shrink: 0;\n        }\n\n        .header_inv_word {\n            font-size: var(--font-size-xl);\n            font-weight: 800;\n            color: var(--color-accent);\n            letter-spacing: -0.5px;\n            text-transform: uppercase;\n        }\n\n        .info_grid {\n            display: flex;\n            justify-content: space-between;\n            margin-top: 16px;\n            gap: 16px;\n        }\n\n        .info_col {\n            display: flex;\n            flex-direction: column;\n            gap: 12px;\n            flex: 1;\n            min-width: 0;\n        }\n\n        .info_col.right_align {\n            align-items: flex-end;\n            text-align: right;\n        }\n\n        .info_block {\n            display: flex;\n            flex-direction: column;\n            gap: 2px;\n        }\n\n        .info_title {\n            font-size: var(--font-size-sm);\n            font-weight: 700;\n            color: var(--color-accent);\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        .info_text {\n            display: flex;\n            flex-direction: column;\n            gap: 1px;\n            font-size: var(--font-size-base);\n            color: var(--color-text-muted);\n        }\n\n        .text_bold {\n            font-weight: 700;\n            color: var(--color-text-bold);\n            font-size: var(--font-size-md);\n        }\n\n        .items_table {\n            width: 100%;\n            border-collapse: collapse;\n            text-align: left;\n        }\n\n        .items_table th {\n            background-color: var(--color-accent);\n            color: #faf6f1;\n            font-size: var(--font-size-sm);\n            font-weight: 700;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            padding: 8px 12px;\n            border-bottom: none;\n        }\n\n        .items_table td {\n            padding: 10px 12px;\n            border-bottom: 1px solid var(--color-border);\n            color: var(--color-text);\n            font-size: var(--font-size-base);\n            vertical-align: top;\n        }\n\n        .items_table th.right,\n        .items_table td.right {\n            text-align: right;\n        }\n\n        .items_table th.center,\n        .items_table td.center {\n            text-align: center;\n        }\n\n        .totals_wrapper {\n            display: flex;\n            justify-content: flex-end;\n        }\n\n        .totals_grid {\n            width: 280px;\n            display: flex;\n            flex-direction: column;\n            gap: 6px;\n        }\n\n        .total_line {\n            display: flex;\n            justify-content: space-between;\n            font-size: var(--font-size-base);\n            color: var(--color-text-muted);\n        }\n\n        .total_line span:last-child {\n            font-weight: 500;\n            color: var(--color-text-bold);\n        }\n\n        .grand_total {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            background-color: var(--color-accent);\n            border-radius: var(--radius);\n            padding: 10px 16px;\n            margin-top: 4px;\n        }\n\n        .grand_total span:first-child {\n            font-size: var(--font-size-md);\n            font-weight: 700;\n            color: #faf6f1;\n            text-transform: uppercase;\n        }\n\n        .grand_total span:last-child {\n            font-size: var(--font-size-total);\n            font-weight: 800;\n            color: #fff;\n        }\n\n        .pay_btn {\n            display: block;\n            background-color: var(--color-accent);\n            color: var(--color-bg);\n            text-decoration: none;\n            padding: 8px 0;\n            border-radius: var(--radius);\n            font-size: var(--font-size-sm);\n            font-weight: 800;\n            text-align: center;\n            margin-top: 8px;\n            letter-spacing: 1px;\n            text-transform: uppercase;\n        }\n\n        .pay_url {\n            margin-top: 2px;\n            font-size: 7px;\n            color: var(--color-text-label);\n            overflow: hidden;\n            text-overflow: ellipsis;\n            white-space: nowrap;\n            text-align: center;\n        }\n\n        .footer_grid {\n            display: flex;\n            flex-direction: column;\n            gap: 8px;\n            border-top: 2px solid var(--color-border-strong);\n            padding-top: 12px;\n            font-size: var(--font-size-sm);\n            color: var(--color-text-label);\n        }\n\n        .footer_section {\n            display: flex;\n            flex-direction: column;\n            gap: 2px;\n        }\n\n        .footer_title {\n            font-weight: 700;\n            color: var(--color-text-bold);\n        }\n\n        .footer_bank {\n            display: flex;\n            flex-wrap: nowrap;\n            gap: 16px;\n            margin-top: 4px;\n            list-style: none;\n            padding: 0;\n        }\n\n        .bank_item {\n            display: flex;\n            gap: 4px;\n            flex: 0 1 auto;\n            min-width: 0;\n        }\n\n        .bank_item span {\n            font-weight: 700;\n            color: var(--color-text-muted);\n        }\n\n        .bank_item .val {\n            font-weight: 400;\n        }\n    </style>\n</head>\n\n<body>\n    <div class=\"a4\">\n        <div class=\"a4_inner\">\n\n            <div class=\"zone_header\">\n                <div class=\"header_row\">\n                    <div class=\"header_brand\">\n                        <img class=\"header_logo\" src=\"{{LOGO}}\" alt=\"\" />\n                        <div class=\"header_company h clamp-2\">{{SENDER_COMPANY_NAME}}</div>\n                    </div>\n                    <div class=\"header_inv\">\n                        <div class=\"header_inv_word\">{{t.INVOICE}}</div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"zone_info\">\n                <div class=\"info_grid\">\n                    <div class=\"info_col\">\n                        <div class=\"info_block hide-if-empty\">\n                            <div class=\"info_title\">{{t.BILL_TO}}</div>\n                            <div class=\"info_text\">\n                                <span class=\"text_bold h clamp-1\">{{CLIENT_COMPANY_NAME}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_CONTACT_NAME}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_ADDRESS}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_CITY}} {{CLIENT_STATE}} {{CLIENT_POSTAL_CODE}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_COUNTRY}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_EMAIL}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_PHONE}}</span>\n                                <span class=\"h clamp-1\">{{CLIENT_TAX_LINE}}</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"info_col\">\n                        <div class=\"info_block hide-if-empty\">\n                            <div class=\"info_title\">{{t.FROM}}</div>\n                            <div class=\"info_text\">\n                                <span class=\"text_bold h clamp-1\">{{SENDER_COMPANY_NAME}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_ADDRESS}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_CITY}} {{SENDER_STATE}} {{SENDER_POSTAL_CODE}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_COUNTRY}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_EMAIL}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_PHONE}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_TAX_LINE}}</span>\n                                <span class=\"h clamp-1\">{{SENDER_REG_LINE}}</span>\n                            </div>\n                        </div>\n                    </div>\n\n                    <div class=\"info_col right_align\">\n                        <div class=\"info_block hide-line\">\n                            <div class=\"info_title\">{{t.INVOICE_NUMBER}}</div>\n                            <div class=\"info_text text_bold clamp-1 h\">{{INVOICE_NUMBER}}</div>\n                        </div>\n                        <div class=\"info_block hide-line\">\n                            <div class=\"info_title\">{{t.ISSUE_DATE}}</div>\n                            <div class=\"info_text clamp-1 h\">{{ISSUE_DATE}}</div>\n                        </div>\n                        <div class=\"info_block hide-line\">\n                            <div class=\"info_title\">{{t.DUE_DATE}}</div>\n                            <div class=\"info_text clamp-1 h\">{{DUE_DATE}}</div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"zone_items\">\n                <table class=\"items_table\">\n                    <thead>\n                        <tr>\n                            <th>{{t.ITEM}}</th>\n                            <th class=\"center\">{{t.QUANTITY}}</th>\n                            <th class=\"right\">{{t.UNIT_PRICE}}</th>\n                            <th class=\"right\">{{t.AMOUNT}}</th>\n                        </tr>\n                    </thead>\n                    <tbody>{{ITEM_ROWS}}</tbody>\n                </table>\n            </div>\n\n            <div class=\"zone_totals\">\n                <div class=\"totals_wrapper\">\n                    <div class=\"totals_grid\">\n                        <div class=\"total_line\">\n                            <span>{{t.SUBTOTAL}}</span>\n                            <span>{{SUBTOTAL_DISPLAY}}</span>\n                        </div>\n                        <div class=\"total_line optional_line\">\n                            <span class=\"clamp-1\">{{t.DISCOUNT}} <span class=\"h\">({{DISCOUNT_LABEL}})</span></span>\n                            <span class=\"h\">{{DISCOUNT_DISPLAY}}</span>\n                        </div>\n                        <div class=\"total_line hide-line\">\n                            <span class=\"clamp-1\">{{t.TAX}} <span class=\"h\">({{TAX_RATE_DISPLAY}})</span></span>\n                            <span class=\"h\">{{TAX_AMOUNT_DISPLAY}}</span>\n                        </div>\n                        <div class=\"grand_total\">\n                            <span>{{t.TOTAL}}</span>\n                            <span>{{TOTAL_DISPLAY}}</span>\n                        </div>\n                        <div class=\"hide-line\"><a href=\"{{PAYMENT_URL}}\" class=\"h pay_btn\">{{t.PAY_ONLINE}}</a><div class=\"h pay_url\">{{PAYMENT_URL}}</div></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"zone_footer\">\n                <div class=\"footer_grid\">\n                    <div class=\"footer_section hide-line\">\n                        <span class=\"footer_title\">{{t.NOTES}}</span>\n                        <span class=\"h clamp-3\">{{NOTES}}</span>\n                    </div>\n                    <div class=\"footer_section hide-line\">\n                        <span class=\"footer_title\">{{t.PAYMENT_TERMS}}</span>\n                        <span class=\"h clamp-1\">{{PAYMENT_TERMS}}</span>\n                    </div>\n                    <ul class=\"footer_bank hide-if-empty\">\n                        <li class=\"bank_item hide-line\"><span>{{t.BANK_NAME}}:</span> <span\n                                class=\"val clamp-1 h\">{{SENDER_BANK_NAME}}</span></li>\n                        <li class=\"bank_item hide-line\"><span>{{t.ACCOUNT_NUMBER}}:</span> <span\n                                class=\"val clamp-1 h\">{{SENDER_ACCOUNT_NUMBER}}</span></li>\n                        <li class=\"bank_item hide-line\"><span>{{t.IBAN}}:</span> <span\n                                class=\"val clamp-1 h\">{{SENDER_IBAN}}</span></li>\n                        <li class=\"bank_item hide-line\"><span>{{t.BIC_SWIFT}}:</span> <span\n                                class=\"val clamp-1 h\">{{SENDER_SWIFT_CODE}}</span></li>\n                    </ul>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</body>\n\n</html>"
}
