{
  "html": "<!-- tier: free -->\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Invoice {{INVOICE_NUMBER}}</title>\n<style>\n:root {\n    --font-family: 'Perpetua', 'Calisto MT', 'Palatino Linotype', serif;\n    --font-size-base: 12px;\n    --font-size-sm: 10px;\n    --font-size-md: 13px;\n    --font-size-lg: 18px;\n    --font-size-xl: 24px;\n    --font-size-total: 16px;\n    --line-height: 1.4;\n    --radius: 6px;\n\n    --color-text: #c5b8cd;\n    --color-text-bold: #e4dae8;\n    --color-text-muted: #907c9a;\n    --color-text-label: #6d5a78;\n    --color-text-faint: #4d3d56;\n    --color-accent: #c084fc;\n    --color-bg: #150e1c;\n    --color-bg-subtle: #1e1528;\n    --color-border: #2d2038;\n    --color-border-strong: #3e2d4c;\n\n    --page-margin-top: 18mm;\n    --page-margin-bottom: 18mm;\n    --page-margin-x: 15mm;\n}\n\n@page { size: A4; margin: 0; }\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: var(--font-family); background-color: var(--color-bg); padding: 0; margin: 0; }\n.a4 { width: 210mm; height: 297mm; background: var(--color-bg); overflow: hidden; position: relative; }\n\n/* Right accent bar */\n.a4::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 5px; background: linear-gradient(180deg, #c084fc 0%, #7c3aed 100%); }\n\n.a4_inner { width: 100%; height: 100%; display: flex; flex-direction: column; font-size: var(--font-size-base); line-height: var(--line-height); color: var(--color-text); -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n\n.h:empty { display: none !important; }\n.hide-line:has(> .h:empty) { display: none !important; }\n.hide-line:has(> .info_text > .h:empty) { display: none !important; }\n.hide-if-empty:not(:has(.h:not(:empty))) { display: none !important; }\n.optional_line:has(.h:empty) { display: none !important; }\n.clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }\n.clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }\n.clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; }\n\n.zone_header { flex: 0 0 auto; width: 100%; padding: var(--page-margin-top) var(--page-margin-x) 0; }\n.zone_info { flex: 0 0 auto; width: 100%; max-height: 200px; overflow: hidden; padding: 0 var(--page-margin-x); }\n.zone_items { flex: 0 0 auto; width: 100%; margin-top: 24px; margin-bottom: 16px; min-height: 80mm; padding: 0 var(--page-margin-x); }\n.zone_totals { flex: 0 0 auto; width: 100%; max-height: 180px; overflow: hidden; padding: 0 var(--page-margin-x); }\n.zone_footer { flex: 0 0 auto; margin-top: auto; width: 100%; padding: 16px var(--page-margin-x) var(--page-margin-bottom); }\n\n.header_row { display: flex; justify-content: space-between; align-items: flex-end; width: 100%; padding-bottom: 10px; border-bottom: 1px solid var(--color-border-strong); }\n.header_brand { display: flex; align-items: center; gap: 10px; max-width: 60%; flex-wrap: wrap; }\n.header_logo { display: block; height: 120px; width: auto; max-width: 280px; min-width: 36px; object-fit: contain; }\n.header_logo[src*=\"R0lGODlhAQABA\"], .header_logo[src=\"\"] { display: none !important; }\n.header_logo:not([src=\"\"]):not([src*=\"R0lGODlhAQABA\"]) + .header_company { display: none !important; }\n.header_company { font-size: var(--font-size-lg); font-weight: 700; color: var(--color-text-bold); }\n.header_inv { text-align: right; flex-shrink: 0; }\n.header_inv_word { font-size: var(--font-size-xl); font-weight: 300; color: var(--color-accent); letter-spacing: 5px; text-transform: uppercase; }\n\n.info_grid { display: flex; justify-content: space-between; margin-top: 16px; gap: 16px; }\n.info_col { display: flex; flex-direction: column; gap: 12px; flex: 1; min-width: 0; }\n.info_col.right_align { align-items: flex-end; text-align: right; }\n.info_block { display: flex; flex-direction: column; gap: 2px; }\n.info_title { font-size: var(--font-size-sm); font-weight: 700; color: var(--color-accent); text-transform: uppercase; letter-spacing: 1.5px; }\n.info_text { display: flex; flex-direction: column; gap: 1px; font-size: var(--font-size-base); color: var(--color-text-muted); }\n.text_bold { font-weight: 700; color: var(--color-text-bold); font-size: var(--font-size-md); }\n\n.items_table { width: 100%; border-collapse: collapse; text-align: left; }\n.items_table th { background-color: transparent; color: var(--color-accent); font-size: var(--font-size-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; padding: 8px 12px; border-bottom: 1px solid var(--color-accent); }\n.items_table td { padding: 10px 12px; border-bottom: 1px solid var(--color-border); color: var(--color-text); font-size: var(--font-size-base); vertical-align: top; }\n.items_table th.right, .items_table td.right { text-align: right; }\n.items_table th.center, .items_table td.center { text-align: center; }\n\n.totals_wrapper { display: flex; justify-content: flex-end; }\n.totals_grid { width: 280px; display: flex; flex-direction: column; gap: 6px; }\n.total_line { display: flex; justify-content: space-between; font-size: var(--font-size-base); color: var(--color-text-muted); }\n.total_line span:last-child { font-weight: 500; color: var(--color-text-bold); }\n.grand_total { display: flex; justify-content: space-between; align-items: center; background: linear-gradient(135deg, #7c3aed 0%, #c084fc 100%); border-radius: var(--radius); padding: 10px 16px; margin-top: 4px; }\n.grand_total span:first-child { font-size: var(--font-size-md); font-weight: 700; color: #fff; text-transform: uppercase; letter-spacing: 2px; }\n.grand_total span:last-child { font-size: var(--font-size-total); font-weight: 800; color: #fff; }\n.pay_btn { display: block; background-color: var(--color-accent); color: var(--color-bg); text-decoration: none; padding: 8px 0; border-radius: var(--radius); font-size: var(--font-size-sm); font-weight: 800; text-align: center; margin-top: 8px; letter-spacing: 1px; text-transform: uppercase; }\n.pay_url { margin-top: 2px; font-size: 7px; color: var(--color-text-label); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; }\n\n.footer_grid { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid var(--color-border-strong); padding-top: 12px; font-size: var(--font-size-sm); color: var(--color-text-label); }\n.footer_section { display: flex; flex-direction: column; gap: 2px; }\n.footer_title { font-weight: 700; color: var(--color-accent); }\n.footer_bank { display: flex; flex-wrap: nowrap; gap: 16px; margin-top: 4px; list-style: none; padding: 0; }\n.bank_item { display: flex; gap: 4px; flex: 0 1 auto; min-width: 0; }\n.bank_item span { font-weight: 700; color: var(--color-text-muted); }\n.bank_item .val { font-weight: 400; }\n</style>\n</head>\n<body>\n<div class=\"a4\"><div class=\"a4_inner\">\n    <div class=\"zone_header\"><div class=\"header_row\">\n        <div class=\"header_brand\"><img class=\"header_logo\" src=\"{{LOGO}}\" alt=\"\" /><div class=\"header_company h clamp-2\">{{SENDER_COMPANY_NAME}}</div></div>\n        <div class=\"header_inv\"><div class=\"header_inv_word\">{{t.INVOICE}}</div></div>\n    </div></div>\n    <div class=\"zone_info\"><div class=\"info_grid\">\n        <div class=\"info_col\"><div class=\"info_block hide-if-empty\"><div class=\"info_title\">{{t.BILL_TO}}</div><div class=\"info_text\"><span class=\"text_bold h clamp-1\">{{CLIENT_COMPANY_NAME}}</span><span class=\"h clamp-1\">{{CLIENT_CONTACT_NAME}}</span><span class=\"h clamp-1\">{{CLIENT_ADDRESS}}</span><span class=\"h clamp-1\">{{CLIENT_CITY}} {{CLIENT_STATE}} {{CLIENT_POSTAL_CODE}}</span><span class=\"h clamp-1\">{{CLIENT_COUNTRY}}</span><span class=\"h clamp-1\">{{CLIENT_EMAIL}}</span><span class=\"h clamp-1\">{{CLIENT_PHONE}}</span><span class=\"h clamp-1\">{{CLIENT_TAX_LINE}}</span></div></div></div>\n        <div class=\"info_col\"><div class=\"info_block hide-if-empty\"><div class=\"info_title\">{{t.FROM}}</div><div class=\"info_text\"><span class=\"text_bold h clamp-1\">{{SENDER_COMPANY_NAME}}</span><span class=\"h clamp-1\">{{SENDER_ADDRESS}}</span><span class=\"h clamp-1\">{{SENDER_CITY}} {{SENDER_STATE}} {{SENDER_POSTAL_CODE}}</span><span class=\"h clamp-1\">{{SENDER_COUNTRY}}</span><span class=\"h clamp-1\">{{SENDER_EMAIL}}</span><span class=\"h clamp-1\">{{SENDER_PHONE}}</span><span class=\"h clamp-1\">{{SENDER_TAX_LINE}}</span><span class=\"h clamp-1\">{{SENDER_REG_LINE}}</span></div></div></div>\n        <div class=\"info_col right_align\"><div class=\"info_block hide-line\"><div class=\"info_title\">{{t.INVOICE_NUMBER}}</div><div class=\"info_text text_bold clamp-1 h\">{{INVOICE_NUMBER}}</div></div><div class=\"info_block hide-line\"><div class=\"info_title\">{{t.ISSUE_DATE}}</div><div class=\"info_text clamp-1 h\">{{ISSUE_DATE}}</div></div><div class=\"info_block hide-line\"><div class=\"info_title\">{{t.DUE_DATE}}</div><div class=\"info_text clamp-1 h\">{{DUE_DATE}}</div></div></div>\n    </div></div>\n    <div class=\"zone_items\"><table class=\"items_table\"><thead><tr><th>{{t.ITEM}}</th><th class=\"center\">{{t.QUANTITY}}</th><th class=\"right\">{{t.UNIT_PRICE}}</th><th class=\"right\">{{t.AMOUNT}}</th></tr></thead><tbody>{{ITEM_ROWS}}</tbody></table></div>\n    <div class=\"zone_totals\"><div class=\"totals_wrapper\"><div class=\"totals_grid\">\n        <div class=\"total_line\"><span>{{t.SUBTOTAL}}</span><span>{{SUBTOTAL_DISPLAY}}</span></div>\n        <div class=\"total_line optional_line\"><span class=\"clamp-1\">{{t.DISCOUNT}} <span class=\"h\">({{DISCOUNT_LABEL}})</span></span><span class=\"h\">{{DISCOUNT_DISPLAY}}</span></div>\n        <div class=\"total_line hide-line\"><span class=\"clamp-1\">{{t.TAX}} <span class=\"h\">({{TAX_RATE_DISPLAY}})</span></span><span class=\"h\">{{TAX_AMOUNT_DISPLAY}}</span></div>\n        <div class=\"grand_total\"><span>{{t.TOTAL}}</span><span>{{TOTAL_DISPLAY}}</span></div>\n        <div class=\"hide-line\"><a href=\"{{PAYMENT_URL}}\" class=\"h pay_btn\">{{t.PAY_ONLINE}}</a><div class=\"h pay_url\">{{PAYMENT_URL}}</div></div>\n    </div></div></div>\n    <div class=\"zone_footer\"><div class=\"footer_grid\">\n        <div class=\"footer_section hide-line\"><span class=\"footer_title\">{{t.NOTES}}</span><span class=\"h clamp-3\">{{NOTES}}</span></div>\n        <div class=\"footer_section hide-line\"><span class=\"footer_title\">{{t.PAYMENT_TERMS}}</span><span class=\"h clamp-1\">{{PAYMENT_TERMS}}</span></div>\n        <ul class=\"footer_bank hide-if-empty\"><li class=\"bank_item hide-line\"><span>{{t.BANK_NAME}}:</span> <span class=\"val clamp-1 h\">{{SENDER_BANK_NAME}}</span></li><li class=\"bank_item hide-line\"><span>{{t.ACCOUNT_NUMBER}}:</span> <span class=\"val clamp-1 h\">{{SENDER_ACCOUNT_NUMBER}}</span></li><li class=\"bank_item hide-line\"><span>{{t.IBAN}}:</span> <span class=\"val clamp-1 h\">{{SENDER_IBAN}}</span></li><li class=\"bank_item hide-line\"><span>{{t.BIC_SWIFT}}:</span> <span class=\"val clamp-1 h\">{{SENDER_SWIFT_CODE}}</span></li></ul>\n    </div></div>\n</div></div>\n</body>\n</html>\n"
}
