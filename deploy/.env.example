# deploy/.env: the only file you edit for deploying (never in git). Copy: cp deploy/.env.example deploy/.env
# Read by deploy/setup.sh and deploy/deploy.sh on your Mac. Nothing of it goes to the server.

# The VPS. You must be able to log in without a password with: ssh root@SERVER_IP
SERVER_IP=
# The website, without https:// or www.
DOMAIN=invoicor.com

# Filled in after `bash deploy/setup.sh info` (it prints the right value): the nginx file that
# serves the domain today, e.g. /etc/nginx/sites-available/invoicor.com
NGINX_SITE=

# Optional. Remove the # to change one, otherwise the default on the right is used.
# SERVER_USER=root                      who you ssh in as, needs root rights. Default: root
# DEPLOY_USER=invoicor_web              the server user GitHub logs in as; it may only write the
#                                       website folder. Default: invoicor_web
# WEB_PATH=/var/www/invoicor.com/web    the website folder, nginx root. Default: /var/www/DOMAIN/web
