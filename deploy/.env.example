# Only for the manual fallback (bash deploy/deploy.sh from your Mac). Automatic deploys use the
# GitHub secrets instead (DEPLOY.md section F). Copy to deploy/.env (never committed) and fill in.

# SSH target for the VPS, as you would type it after `ssh`.
SSH_TARGET=deploy@your-server-ip

# The website folder on the server (nginx `root` points here).
WEB_PATH=/var/www/invoicor.com/web
