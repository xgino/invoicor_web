# Copy to deploy/.env (never committed) and fill in.

# SSH target for the VPS, as you would type it after `ssh`.
SSH_TARGET=user@your-server-ip

# Folder on the server that holds the website. nginx serves $SITE_DIR/site
SITE_DIR=/var/www/invoicor.com

# Staging (optional, for `bash deploy/deploy.sh --staging`). nginx serves $STAGING_DIR/site
# at https://staging.invoicor.com behind a password (deploy/nginx/staging.invoicor.com.conf).
STAGING_DIR=/var/www/staging.invoicor.com
# The staging password, as user:password (used by the deploy check and the parity script).
STAGING_AUTH=
