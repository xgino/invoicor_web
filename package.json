{
  "name": "invoicor-web",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website for Invoicor (invoicor.com), built with Next.js as a static export.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "node scripts/content-check.mjs",
    "test:unit": "vitest run tests/unit",
    "test:site": "vitest run tests/site",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:site && npm run test:e2e",
    "parity": "node scripts/parity-check.mjs",
    "api:types": "openapi-typescript \"https://invoicor.com/api/schema/?format=json\" -o types/api.generated.ts",
    "check": "npm run lint && npm run typecheck && npm run content:check && npm run test:unit && npm run build && npm run test:site && npm run test:e2e",
    "prepare": "husky",
    "pages": "node scripts/pages.mjs",
    "pages:category": "node scripts/pages-category.mjs",
    "pages:page": "node scripts/pages-page.mjs",
    "pages:gaps": "node scripts/pages-gaps.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "lucide-react": "1.74.0",
    "modern-screenshot": "4.7.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": "prettier --write",
    "content/*.json": "node scripts/content-check.mjs"
  }
}
